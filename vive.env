# vive-monado-steam-pop — environment for Monado + Proton on AMD RADV.
# Source this file from the launch scripts. Do not source from SteamVR.
#
# Any AMD RADV box. Vive 2016 / Pro / Pro Eye / Pro 2.
# Ultralight: no debug layers, no overlay HUD, no extra logging, 1.0 scale.
# Envision is not used. SteamVR must not run as the compositor.

export AMD_VULKAN_ICD=RADV
export RADV_PERFTEST="${RADV_PERFTEST:-vr}"

# steamvr_lh wraps the installed SteamVR lighthouse binary. SteamVR stays dead.
export STEAMVR_LH_ENABLE=1

# AMD async reprojection. Costs a compute queue; without it this GPU hitch-steps.
# CAP_SYS_NICE on monado-service is required for the reproject thread.
export XRT_COMPOSITOR_COMPUTE=1
export XRT_COMPOSITOR_SCALE_PERCENTAGE="${XRT_COMPOSITOR_SCALE_PERCENTAGE:-100}"
export XRT_LOG="${XRT_LOG:-error}"

# Stay on X11. Do not force Wayland or a debug peek window.
unset XRT_COMPOSITOR_FORCE_WAYLAND 2>/dev/null || true
unset XRT_COMPOSITOR_FORCE_WAYLAND_DIRECT 2>/dev/null || true
unset XRT_COMPOSITOR_FORCE_XCB 2>/dev/null || true
unset XRT_DEBUG_GUI 2>/dev/null || true
unset XRT_CURATED_GUI 2>/dev/null || true
unset VK_LOADER_DEBUG 2>/dev/null || true
unset RADV_DEBUG 2>/dev/null || true
unset MESA_DEBUG 2>/dev/null || true
unset VK_INSTANCE_LAYERS 2>/dev/null || true
unset VK_LOADER_LAYERS_ENABLE 2>/dev/null || true

# Glibc: stop arena sprawl on a long-lived compositor.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# Proton / DXVK — quiet logs, keep Steam overlay (Home / library / in-game).
export WINEDEBUG="${WINEDEBUG:--all}"
export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
export DXVK_HUD="${DXVK_HUD:-0}"
export VKD3D_DEBUG="${VKD3D_DEBUG:-none}"
export VKD3D_SHADER_DEBUG="${VKD3D_SHADER_DEBUG:-none}"
export DISABLE_MANGOHUD=1
export MANGOHUD=0

# Standalone prefix from ./build.sh
_VIVE_PREFIX="${VIVE_MONADO_PREFIX:-${HOME}/.local/opt/vive-monado}"
if [ -d "${_VIVE_PREFIX}/bin" ]; then
  export PATH="${_VIVE_PREFIX}/bin:${PATH}"
fi
if [ -d "${_VIVE_PREFIX}/lib/xrizer" ]; then
  export VR_OVERRIDE="${VR_OVERRIDE:-${_VIVE_PREFIX}/lib/xrizer}"
fi

export PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES=1
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  export PRESSURE_VESSEL_FILESYSTEMS_RW="${XDG_RUNTIME_DIR}/monado_comp_ipc"
else
  export PRESSURE_VESSEL_FILESYSTEMS_RW="/run/user/$(id -u)/monado_comp_ipc"
fi

if [ -z "${XR_RUNTIME_JSON:-}" ]; then
  if [ -f "${_VIVE_PREFIX}/share/openxr/1/openxr_monado.json" ]; then
    export XR_RUNTIME_JSON="${_VIVE_PREFIX}/share/openxr/1/openxr_monado.json"
  elif [ -f "${HOME}/.config/openxr/1/active_runtime.json" ]; then
    export XR_RUNTIME_JSON="${HOME}/.config/openxr/1/active_runtime.json"
  elif [ -f "${HOME}/.config/openxr/1/openxr_monado.json" ]; then
    export XR_RUNTIME_JSON="${HOME}/.config/openxr/1/openxr_monado.json"
  fi
fi
unset _VIVE_PREFIX

export VR_DISABLE_STEAMVR="${VR_DISABLE_STEAMVR:-1}"

# Vive Pro 2 only (leave unset on Vive / Vive Pro):
# export VP2_RESOLUTION=2
# export LH_OVERRIDE_IPD_MM=66

